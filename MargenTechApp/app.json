{
  "expo": {
    "name": "Margen Technician",
    "slug": "margen-technician",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "margentech",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.margen.technician",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Margen shares your location with dispatch only while you are clocked in.",
        "NSCameraUsageDescription": "Take before and after photos for job records.",
        "NSPhotoLibraryUsageDescription": "Attach photos to job records.",
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAFAF8"
      },
      "package": "com.margen.technician",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Margen uses your location about once per minute while you are clocked in."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Margen to take job photos.",
          "microphonePermission": "Allow Margen to record video with audio for job photos.",
          "recordAudioAndroid": true
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "supabaseUrl": "https://pwguheewwpqpdokcwztk.supabase.co",
      "supabaseAnonKey": "sb_publishable_2GcnKvg56uYoBCzXLb76TA_UTpQHPOY",
      "eas": {
        "projectId": "65c7cf37-80a7-4253-911b-7c4af151449d"
      }
    }
  }
}
