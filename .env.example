# Next.js public env (exposed to the browser — prefix with NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: Google Maps JavaScript API (enable Maps JavaScript, Places, Geocoding).
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Site URL for links and redirects
# NEXT_PUBLIC_SITE_URL=https://trymargen.com

# Synthetic auth email host for technicians (no mailbox; Supabase Auth only)
# NEXT_PUBLIC_INVITE_EMAIL_DOMAIN=invite.trymargen.com

# Shared Retell AI (Margen-managed account)
# NEXT_PUBLIC_RETELL_API_KEY=

# Stripe Connect OAuth (Payments → Connect with Stripe)
# NEXT_PUBLIC_STRIPE_CONNECT_CLIENT_ID=ca_...
# Edge: STRIPE_CONNECT_CLIENT_ID (same ca_... value), STRIPE_CONNECT_REDIRECT_URI=https://trymargen.com/settings/stripe-callback
# STRIPE_SECRET_KEY is the platform secret used to exchange OAuth codes.

# Stripe — client subscription checkout
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# NEXT_PUBLIC_STRIPE_STARTER_PRICE_ID=price_...
# NEXT_PUBLIC_STRIPE_GROWTH_PRICE_ID=price_...
# NEXT_PUBLIC_STRIPE_SCALE_PRICE_ID=price_...
# Optional separate annual recurring prices (10× monthly). If omitted, annual uses the monthly price ID.
# NEXT_PUBLIC_STRIPE_STARTER_PRICE_ID_ANNUAL=price_...
# NEXT_PUBLIC_STRIPE_GROWTH_PRICE_ID_ANNUAL=price_...
# NEXT_PUBLIC_STRIPE_SCALE_PRICE_ID_ANNUAL=price_...
# Success/cancel URLs use NEXT_PUBLIC_SITE_URL when set, else window.location.origin.

# Supabase Edge (webhook + billing portal + cancel): STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET,
# STRIPE_PRICE_STARTER, STRIPE_PRICE_GROWTH, STRIPE_PRICE_SCALE (same Price ID strings as NEXT_PUBLIC_* for webhook plan matching),
# optional STRIPE_PRICE_*_ANNUAL for annual rows, plus PUBLIC_SITE_URL / SITE_URL for other flows.
# Optional: extra dev emails (comma-separated) that skip paid-subscription gate
# NEXT_PUBLIC_DEV_BYPASS_EMAILS=

# Owner-pasted Stripe keys (Settings → analytics sync): set STRIPE_USER_KEY_ENCRYPTION_SECRET on Edge (long random
# string, min 16 chars) so keys are encrypted at rest before storage in stripe_analytics_credentials.
# Retell Edge Functions (e.g. test call) also accept RETELL_API_KEY as a Supabase secret (same key value).

# Twilio (Edge: provision-twilio-number, send-forwarding-sms, inbound voice) — set on Supabase:
# TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_FROM_NUMBER (E.164 for SMS)
# RETELL_TWILIO_INBOUND_WEBHOOK_URL — full Retell Twilio voice webhook URL for purchased numbers (Retell dashboard)
# PUBLIC_FUNCTIONS_BASE_URL — e.g. https://<ref>.supabase.co/functions/v1 (for Twilio status callbacks)
